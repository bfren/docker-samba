#!/usr/bin/nu

use bf
use bf-s6
bf env load

# Start Samba in foreground mode
def main [
    name: string    # The service name, passed by s6-supervise
] {
    # set executable name - used to make log output more useful
    bf env x_set --override run $name

    # run checks before executing service
    bf write debug "No pre-run checks required."

    # launch Samba service
    bf write "Starting Samba in foreground mode."
    let args = [
        $"--configfile=(bf env SAMBA_CONF)"
        "--debug-stdout"
        "--foreground"
        "--no-process-group"
    ]
    bf-s6 svc launch smbd ...$args
}
